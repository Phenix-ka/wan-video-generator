# Wan Video Generator — environment variables.
# Copy to .env and fill in. NEVER commit a real .env with secrets.
# Every value below is a placeholder.

# --- Server ---
PORT=3000
# Public URL of the frontend (for CORS). Leave empty to allow any origin (dev).
FRONTEND_URL=
# Secret for signing login tokens. REQUIRED in production — generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Email of the owner account (sees the Settings tab). The first account
# created is also owner, so this is optional on a fresh install.
OWNER_EMAIL=
# SQLite file. Default: ./data/wan-saas.db
DATABASE_PATH=./data/wan-saas.db

# --- GPU worker (real rendering) ---
# Leave empty = DEMO MODE (jobs complete with labeled sample videos).
# provider: runpod | vastai | custom
WORKER_PROVIDER=
# Custom / Vast.ai worker base URL (your pod running the worker API).
WORKER_URL=
# API key sent to the custom worker (header X-API-Key). Empty = none.
WORKER_API_KEY=
# RunPod serverless endpoint ID (only when WORKER_PROVIDER=runpod).
WORKER_ENDPOINT_ID=

# --- PayPal (primary fiat rail) ---
# Create a REST API app at developer.paypal.com — sandbox first, then live.
# Ask PayPal for the MICROPAYMENTS rate (5% + $0.05) — much cheaper on $1 videos.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_MODE=sandbox

# --- BTCPay Server (primary crypto rail: Lightning + on-chain BTC) ---
# Self-hosted on your VPS (0% fees, no KYC). Your personal wallets
# (Wallet of Satoshi, Zeus) CANNOT issue the app's invoices — the app
# needs BTCPay Server or LNbits here.
BTCPAY_URL=
BTCPAY_API_KEY=
BTCPAY_STORE_ID=

# --- Other providers (keys can be saved; checkout NOT wired yet) ---
PADDLE_API_KEY=
STRIPE_SECRET_KEY=
LEMON_SQUEEZY_API_KEY=
